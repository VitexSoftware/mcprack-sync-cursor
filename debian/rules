#!/usr/bin/make -f

export PYBUILD_NAME=mcprack-sync-cursor

%:
	dh $@ --with python3 --buildsystem=pybuild

override_dh_auto_test:
	@echo "skipping tests at package build (covered in mcprack-client)"

override_dh_install:
	dh_install
	install -D -m 644 systemd/mcprack-sync-cursor.service \
		debian/mcprack-sync-cursor/usr/lib/systemd/user/mcprack-sync-cursor.service
	install -D -m 644 systemd/mcprack-sync-cursor.timer \
		debian/mcprack-sync-cursor/usr/lib/systemd/user/mcprack-sync-cursor.timer
